# PostgreSQL (Docker Compose)
POSTGRES_DB=atrium
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium_dev_password
POSTGRES_PORT=5433

# Atrium API
API_PORT=5000
# Bind address on host (use 127.0.0.1 when behind Caddy or another reverse proxy, 0.0.0.0 for direct LAN/HTTP access)
API_BIND_ADDRESS=0.0.0.0

# Comma-separated allowed browser origins for CORS (required when hosting the frontend on GitHub Pages)
# Example: CORS_ORIGINS=https://andraskurtos.github.io
CORS_ORIGINS=

# Optional: domain name for automatic HTTPS via Caddy (enable with: docker compose --profile https up -d --build)
# Example: ATRIUM_DOMAIN=api.example.com
ATRIUM_DOMAIN=

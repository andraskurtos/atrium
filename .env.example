# PostgreSQL (Docker Compose)
POSTGRES_DB=atrium
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium_dev_password
POSTGRES_PORT=5433

# Atrium server (serves both frontend PWA and API)
API_PORT=5000
# Bind address on host (use 0.0.0.0 for LAN/direct access, 127.0.0.1 when behind Caddy/Tailscale/Cloudflare Tunnel/Nginx)
API_BIND_ADDRESS=0.0.0.0

# Optional: domain name for automatic HTTPS via Caddy (enable with: docker compose --profile https up -d --build)
# Example: ATRIUM_DOMAIN=atrium.example.com
ATRIUM_DOMAIN=

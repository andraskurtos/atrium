# PostgreSQL (Docker Compose)
POSTGRES_DB=atrium
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium_dev_password
POSTGRES_PORT=5433

# Atrium server (serves both frontend PWA and API)
API_PORT=5000
# Bind address on host (use 0.0.0.0 for LAN/direct access, 127.0.0.1 when behind Caddy/Tailscale/Cloudflare Tunnel/Nginx)
API_BIND_ADDRESS=0.0.0.0
# Production JWT signing secret (REQUIRED in Production; >= 32 random chars, e.g. `openssl rand -base64 48`)
# Leave blank here; scripts/setup-server.sh generates one automatically for Docker deployments.
ATRIUM_JWT_SECRET=

# Optional: domain name for automatic HTTPS via Caddy (enable with: docker compose --profile https up -d --build)
# Example: ATRIUM_DOMAIN=atrium.example.com
ATRIUM_DOMAIN=

# Optional: host directory for uploaded files (PDFs, images, chat attachments).
# Leave blank to use the Docker named volume 'atrium_uploads' in Docker Compose
# (or api/Atrium.Api/uploads in local dev).
# When using a host path with Docker, ensure it is writable by UID 1654 (e.g. `sudo chown -R 1654:1654 /srv/atrium/uploads`).
# ATRIUM_UPLOADS_PATH=/srv/atrium/uploads

# Optional: Backup settings (used by scripts/backup.sh and scripts/restore.sh)
# ATRIUM_BACKUP_DIR=./backups
# ATRIUM_BACKUP_KEEP=14
# ATRIUM_BACKUP_COPY_DIR=/mnt/external-drive/atrium-backups
# ATRIUM_BACKUP_RCLONE_REMOTE=
# ATRIUM_BACKUP_SCHEDULE=*-*-* 03:30:00

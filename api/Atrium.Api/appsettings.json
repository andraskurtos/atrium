{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Atrium": {
    "Database": {
      "AutoMigrate": true
    },
    "Auth": {
      "JwtSigningKey": "",
      "Issuer": "atrium",
      "Audience": "atrium-client",
      "AccessTokenMinutes": 15,
      "RefreshSlidingDays": 30,
      "RefreshAbsoluteDays": 90
    }
  }
}
